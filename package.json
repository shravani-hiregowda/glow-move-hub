{
  "name": "jerai-fit-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@jerai/web",
    "dev:api": "npm run dev --workspace=@jerai/api",
    "build": "npm run build --workspace=@jerai/web && npm run build --workspace=@jerai/api",
    "build:web": "npm run build --workspace=@jerai/web",
    "build:api": "npm run build --workspace=@jerai/api",
    "lint": "eslint .",
    "test": "npm run test:shared && npm run test:web && npm run test:api",
    "test:shared": "npm run test --workspace=@jerai/shared",
    "test:web": "npm run test --workspace=@jerai/web",
    "test:api": "npm run test --workspace=@jerai/api",
    "typecheck": "npm run typecheck --workspace=@jerai/shared && npm run typecheck --workspace=@jerai/api && npm run typecheck --workspace=@jerai/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
