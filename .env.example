# JERAI FIT (Glow Move Hub) - Environment Template
# IMPORTANT: Never commit actual secret values or credentials.
# Vite frontend variables MUST be prefixed with VITE_ to be exposed to the client.
# Any private server-side secrets (DB credentials, secret keys) must NOT have the VITE_ prefix.

# --- Client-Side Configuration (Vite) ---
# Base URL for future backend API (e.g. http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# --- Future Backend Configuration (Phase 3+) ---
# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=prefer
DATABASE_URL=postgresql://postgres:password@localhost:5432/jerai_fit

# API Server Port
PORT=5000

# Server-only Session/JWT Secret (Generate a strong random 256-bit key)
SESSION_SECRET=replace_with_a_secure_random_string_in_production
