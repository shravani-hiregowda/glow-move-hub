# JERAI FIT (Glow Move Hub) - Environment Template
# IMPORTANT: Never commit actual secret values or credentials.
# Vite frontend variables MUST be prefixed with VITE_ to be exposed to the client.
# Any private server-side secrets (DB credentials, secret keys) must NOT have the VITE_ prefix.

# --- Client-Side Configuration (apps/web) ---
# Base URL for backend API (leave empty to use relative /api/v1 via Vite proxy in development)
VITE_API_URL=http://localhost:3000/api/v1

# --- Server-Side Configuration (apps/api) ---
NODE_ENV=development
PORT=3000

# PostgreSQL Connection URL (Server-side only)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jerai_fit?schema=public

# Optional Direct PostgreSQL Connection URL (for Prisma migrations with PgBouncer/Neon pooled DBs)
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/jerai_fit?schema=public

# Allowed CORS origins (Narrow credentialed origin)
CORS_ORIGIN=http://localhost:8080

# Reverse Proxy Trust (Set to "1" if behind a single reverse proxy like Render, Caddy, or Cloudflare, or "loopback")
# Leave unset or empty in local development to prevent client IP spoofing against rate limits.
# TRUST_PROXY=1

# Cloudflare Pages Functions <-> Render Proxy Authentication Secret
# REQUIRED in production: Server fails closed on startup if missing or empty.
# In development/testing, leave unset unless explicitly testing proxy authentication.
# PROXY_SECRET=your-random-64-char-secret-here
# REQUIRE_PROXY_AUTH=false

# --- One-Time Administrator Bootstrap ---
# Recommended: Run `npm run admin:bootstrap` interactively to securely input credentials without shell history exposure.
# Non-interactive / CI fallback only:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMeWithAStrongPassword123!

# --- Object Storage Configuration ---
# Storage driver: "local" (default for offline dev & test), "r2" (Cloudflare R2), or "s3" (Amazon S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# Cloudflare R2 / Amazon S3 settings (required only when STORAGE_DRIVER is "r2" or "s3")
# For Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=jerai-fit-media
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_PUBLIC_URL_PREFIX=https://pub-<hash>.r2.dev
