# JERAI FIT (Glow Move Hub) - Environment Template
# IMPORTANT: Never commit actual secret values or credentials.
# Vite frontend variables MUST be prefixed with VITE_ to be exposed to the client.
# Any private server-side secrets (DB credentials, secret keys) must NOT have the VITE_ prefix.

# --- Client-Side Configuration (apps/web) ---
# Base URL for backend API (leave empty to use relative /api/v1 via Vite proxy in development)
VITE_API_URL=http://localhost:3000/api/v1

# --- Server-Side Configuration (apps/api) ---
NODE_ENV=development
PORT=3000

# PostgreSQL Connection URL (Server-side only)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jerai_fit?schema=public

# Fail-Closed Security Guard Opt-in (Non-production local development only)
# Set to true to exercise workout create/update/delete before Phase 4 authentication is installed.
# WARNING: The server will refuse to start if this flag is true when NODE_ENV=production.
ALLOW_LOCAL_DEV_WRITES=false

# Allowed CORS origins
CORS_ORIGIN=http://localhost:8080
